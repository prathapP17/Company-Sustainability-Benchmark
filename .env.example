# Copy to .env.local (git-ignored) and fill in. Never commit .env.local.
# For a hosted deployment use deploy/.env.example instead.

# The review area at /review needs an account. Create the first admin with:
#   npm run users -- invite --email you@example.org --name "Your Name" --role admin
# (Phase 3's REVIEWER_TOKEN is no longer used.)

# Leave empty on this Mac (local mode: the review area only answers on localhost).
# Set by docker compose in hosted mode, e.g. https://benchmark.example.org
# APP_ORIGIN=

# Optional: turns on Claude extraction (claude-opus-5-5) in the worker. Costs API credits per document.
ANTHROPIC_API_KEY=

# Optional: worker pauses claiming jobs below this much available memory (MB). Default 512.
# WORKER_MIN_FREE_MB=512

# Optional: enables SEC EDGAR discovery. The SEC requires a contact in the User-Agent,
# e.g. "Your Organisation your-contact@example.org". Leave empty to skip EDGAR.
SEC_USER_AGENT=
