# Copy to .env.local (git-ignored) and fill in. Never commit .env.local.

# Enables the local-only upload/review pipeline at /review (at least 16 characters).
# Generate one with:  openssl rand -base64 24
REVIEWER_TOKEN=

# Optional: turns on Claude extraction (claude-opus-5-5) in the worker. Costs API credits per document.
ANTHROPIC_API_KEY=

# Optional: worker pauses claiming jobs below this much available memory (MB). Default 512.
# WORKER_MIN_FREE_MB=512
