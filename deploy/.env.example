# Copy to deploy/.env on the server (never commit deploy/.env).
# docker compose reads DOMAIN from here via: docker compose --env-file deploy/.env up -d --build

# Public domain name; its DNS A/AAAA record must point at this server.
DOMAIN=benchmark.example.org

# Optional: Claude extraction (leave empty to use rule-based extraction only).
ANTHROPIC_API_KEY=

# Optional: SEC EDGAR discovery. SEC asks for your organisation and a contact email.
SEC_USER_AGENT=

# Optional: schedules (IANA time zone; "Mon 07:00", "daily 03:00").
SCHEDULE_TZ=UTC
REFRESH_SCHEDULE=Mon 07:00
BACKUP_SCHEDULE=daily 03:00
BACKUP_KEEP=14

# Worker pauses claiming jobs when free memory drops below this (MB).
WORKER_MIN_FREE_MB=512
