# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
# testing
/coverage
# next.js
/.next/
/out/
# production
/build
# misc
.DS_Store
*.pem
# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
# env files (can opt-in for committing if needed)
.env*
# vercel
.vercel
# typescript
*.tsbuildinfo
next-env.d.ts
.env
.env.*
node_modules/
__pycache__/
.venv/
.claude/settings.local.json

# local data (never commit real DBs or downloads)
/data/*.db
/data/*.db-*
/data/backups/
/data/public-url.txt
/scratch/
/data/uploads/
.env*.local
!.env.example
/data/logs/
