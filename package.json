{
  "name": "corporate-sustainability-intelligence",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prebuild": "npm run validate && npm run seed",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "validate": "tsx scripts/validate-data.ts",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "test:e2e": "tsx scripts/e2e.ts",
    "extract-text": "tsx scripts/extract-text.ts",
    "worker": "tsx scripts/worker.ts",
    "test:e2e:pipeline": "tsx scripts/e2e-pipeline.ts",
    "refresh": "tsx scripts/refresh.ts",
    "launchd:print": "zsh ops/launchd/install.sh --print",
    "launchd:install": "zsh ops/launchd/install.sh",
    "launchd:uninstall": "zsh ops/launchd/uninstall.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "better-sqlite3": "^13.2.0",
    "exceljs": "^4.4.0",
    "next": "16.4.6",
    "pdfjs-dist": "^6.5.438",
    "pdfkit": "^0.21.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.11.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "playwright-core": "^1.65.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
